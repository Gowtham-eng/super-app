<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/in_app_close_bar"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/in_app_toolbar_bg_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/in_app_back_chip"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/in_app_back_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/in_app_back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/back_to_launcher"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_in_app_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/in_app_brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="@string/back_to_app_center"
                android:textColor="#047857"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/in_app_close_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/in_app_loading"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
