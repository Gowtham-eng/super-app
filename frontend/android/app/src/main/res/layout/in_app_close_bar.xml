<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/in_app_close_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/in_app_toolbar_bg_compact"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:visibility="gone">

    <!-- Back to RefexOne -->
    <LinearLayout
        android:id="@+id/in_app_back_chip"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/in_app_back_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/in_app_icon_circle">

            <ImageView
                android:id="@+id/in_app_back_button"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/back_to_launcher"
                android:scaleType="centerInside"
                android:src="@drawable/ic_in_app_back" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/in_app_brand_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="@string/back_to_app_center"
                android:textColor="#065F46"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/in_app_close_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/in_app_loading"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Refresh -->
    <LinearLayout
        android:id="@+id/in_app_refresh_chip"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/in_app_action_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="44dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/in_app_refresh_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/refresh_page"
            android:scaleType="centerInside"
            android:src="@drawable/ic_in_app_refresh" />

        <TextView
            android:id="@+id/in_app_refresh_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/refresh_page"
            android:textColor="#047857"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
