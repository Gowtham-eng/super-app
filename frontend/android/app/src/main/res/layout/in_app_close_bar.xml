<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/in_app_close_bar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/in_app_toolbar_bg"
    android:elevation="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="16dp"
    android:visibility="gone">

    <ImageButton
        android:id="@+id/in_app_back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/in_app_back_ripple"
        android:contentDescription="@string/back_to_launcher"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_in_app_back" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/in_app_brand_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/in_app_close_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/in_app_loading"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
